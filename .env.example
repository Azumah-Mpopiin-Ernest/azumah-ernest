# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Values come from Firebase Console → Project settings → Your apps → Web app.
# (These are public identifiers, not secrets; security comes from the rules files.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Google account allowed into /admin (must match firestore.rules and storage.rules)
VITE_ADMIN_EMAIL=
