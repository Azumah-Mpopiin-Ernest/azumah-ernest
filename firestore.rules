rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the Google account you sign in with (lowercase).
    // Keep it in sync with VITE_ADMIN_EMAIL and storage.rules.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'REPLACE_WITH_YOUR_GOOGLE_EMAIL';
    }

    function validProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.published is bool
        && data.featured is bool;
    }

    // Visitors can read published projects only; drafts are yours.
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isOwner();
      allow create, update: if isOwner() && validProject(request.resource.data);
      allow delete: if isOwner();
    }

    // Public profile (bio, contacts, skills).
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Private notes: never readable by anyone else.
    match /notes/{noteId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
