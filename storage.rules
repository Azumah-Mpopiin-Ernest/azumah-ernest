rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Must match the email in firestore.rules.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'teslajunior0552@gmail.com';
    }

    function isSmallDocument() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    function isVideo() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Project images, profile photo, CV and About-page media: public to read, only you can upload.
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner() && isSmallDocument();
      allow delete: if isOwner();
    }

    // About-page videos get a larger limit.
    match /public/about/videos/{file} {
      allow read: if true;
      allow create, update: if isOwner() && isVideo();
      allow delete: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
